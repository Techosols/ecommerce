# ─────────────────────────────────────────────────────────────────────────────
# Ecommerce server — environment configuration
#
# Copy to `.env` and fill in. NEVER put real credentials in this file.
# Every variable is validated by src/config/env.ts at boot; a missing or
# malformed value stops the process immediately with a readable report.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | test | production
APP_ENV=local                        # local | staging | production
PORT=4000
LOG_LEVEL=debug                      # fatal | error | warn | info | debug
LOG_PRETTY=true                      # human-readable logs; leave false in production

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL       : used by the API process.
#                      On Supabase this is the TRANSACTION POOLER (port 6543).
# DATABASE_DIRECT_URL: used by the worker process, the migration CLI and pg-boss,
#                      all of which need session-level features (advisory locks,
#                      LISTEN/NOTIFY). On Supabase this is the DIRECT connection
#                      (port 5432). Locally the two are usually the same URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce
DATABASE_DIRECT_URL=postgres://postgres:postgres@localhost:5432/ecommerce
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_SSL=false                   # true for Supabase and any managed Postgres

# ── Authentication ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=ecommerce-api
# Set during a secret rotation so tokens signed with the old secret still verify.
# JWT_PREVIOUS_ACCESS_SECRET=

# Credential flows
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
LOGIN_MAX_FAILURES=10                # consecutive failures before the account locks
LOGIN_FAILURE_WINDOW_MINUTES=15

# Refresh-cookie SameSite. `strict` is correct when the frontends share a
# registrable domain with the API. Use `none` (which forces Secure and requires
# HTTPS origins) only when they genuinely cannot.
AUTH_COOKIE_SAMESITE=strict

# ── CORS (§16.2 — explicit allowlist, no wildcards) ──────────────────────────
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
# COOKIE_DOMAIN=

# ── Queue / workers ──────────────────────────────────────────────────────────
RUN_WORKERS_IN_PROCESS=true          # development convenience: one process, no second terminal
QUEUE_SCHEMA=pgboss
EVENT_DISPATCH_INTERVAL_MS=500
EVENT_DISPATCH_BATCH_SIZE=50

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console               # console | smtp   (console writes .eml files to tmp/mail)
EMAIL_FROM=store@example.com
# EMAIL_REPLY_TO=support@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── Realtime ─────────────────────────────────────────────────────────────────
SOCKET_ENABLED=true
SOCKET_MAX_CONNECTIONS_PER_USER=10

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HOPS=0                   # number of proxies in front of the app

# ── Observability ────────────────────────────────────────────────────────────
METRICS_ENABLED=false
# METRICS_TOKEN=

# ── First owner account (used only by `npm run db:seed`) ─────────────────────
# Roles and permissions are seeded by migration 0004. This is the human who will
# administer the store. Never commit a real password here.
# SEED_OWNER_EMAIL=owner@example.com
# SEED_OWNER_PASSWORD=

# ── Object storage (§46) ─────────────────────────────────────────────────────
# supabase | local | memory. Production is forced to `supabase`; `local` writes
# to STORAGE_LOCAL_DIR and serves dev-only signed URLs from this server.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=tmp/storage
STORAGE_LOCAL_BASE_URL=http://localhost:4000/local-storage

# Supabase is used for OBJECT STORAGE ONLY. Database access stays on `pg` and
# DATABASE_URL — do not point the app at Supabase via its client libraries.
# The service-role key is a server-side secret: it must never reach a browser,
# a log line, an API response or the repository.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
SUPABASE_STORAGE_PUBLIC=true         # false issues short-lived signed download URLs instead

# ── Media ────────────────────────────────────────────────────────────────────
MEDIA_MAX_BYTES=10485760             # 10 MiB per upload, enforced server-side
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_SIGNED_URL_TTL_SECONDS=3600

# ── Staff invitations ────────────────────────────────────────────────────────
STAFF_INVITATION_TTL_HOURS=72

# ── Tests ────────────────────────────────────────────────────────────────────
# Integration tests need their own database. They REFUSE to run against a URL
# whose database name does not contain "test", so production data cannot be wiped.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce_test

# ── Live Supabase Storage tests (opt in) ─────────────────────────────────────
# Unset, the Supabase integration tests run against a mocked SDK client and the
# live suite SKIPS. Set all three to exercise the real service — use a throwaway
# project and a bucket you are happy to have objects created and deleted in.
# SUPABASE_TEST_URL=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
# SUPABASE_TEST_BUCKET=media-test
