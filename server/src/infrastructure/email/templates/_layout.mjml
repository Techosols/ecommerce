<mjml>
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-preview>{{ preview }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#1f2933" />
      <mj-section padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-section padding="24px 0 8px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#0b3d2e">
          {{ storeName }}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="24px" border-radius="8px">
      <mj-column> {{{body}}} </mj-column>
    </mj-section>

    <mj-section padding="16px 0 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#7b8794">
          {{ storeName }}{{#if supportEmail}} · {{ supportEmail }}{{/if}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
