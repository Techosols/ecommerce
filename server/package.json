{
  "name": "@ecommerce/server",
  "version": "0.1.0",
  "private": true,
  "description": "Ecommerce platform backend — modular monolith (foundation)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main/api.ts",
    "dev:worker": "tsx watch src/main/worker.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:templates",
    "build:templates": "tsx scripts/build-templates.ts",
    "start": "node dist/main/api.js",
    "start:worker": "node dist/main/worker.js",
    "db:migrate": "tsx src/infrastructure/database/migrate/cli.ts up",
    "db:migrate:status": "tsx src/infrastructure/database/migrate/cli.ts status",
    "db:migrate:create": "tsx src/infrastructure/database/migrate/cli.ts create",
    "db:reset": "tsx src/infrastructure/database/migrate/cli.ts reset",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:categories": "tsx scripts/seed-categories.ts",
    "dev:catalogue": "tsx scripts/dev/demo-catalogue.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "@types/sanitize-html": "^2.16.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mjml": "^5.4.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mjml": "^5.0.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
