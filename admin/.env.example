# Admin configuration. Copy to `.env.local` and adjust.
#
# Nothing secret belongs in this file: every VITE_* variable is inlined into the
# JavaScript bundle and is readable by anyone who opens the page.

# Where the API lives.
#
# Leave EMPTY in development: `vite.config.ts` proxies /api and /socket.io to
# the backend, so the browser sees one origin and the refresh cookie — which
# the server scopes to /api/v1/auth and marks SameSite — behaves exactly as it
# will in production.
#
# In production set it to the API's origin, and make sure that origin is listed
# as ADMIN_ORIGIN in the server's environment so its credentialed CORS
# allowlist accepts this application.
VITE_API_URL=

# Must match the server's API_BASE_PATH.
VITE_API_BASE_PATH=/api/v1

# Must match the Socket.IO `path` option in the server's realtime setup.
VITE_SOCKET_PATH=/socket.io

# Shown in the sidebar, the header and the browser tab.
VITE_APP_NAME=Store Admin

# Dev-server only: where `vite dev` proxies /api and /socket.io.
VITE_DEV_API_PROXY=http://localhost:4000
